{
  "format": "miot-spec-v2",
  "models": {
    "yeelink.light.lamp4": {
      "source": "https://miot-spec.org/miot-spec-v2/instance?type=urn:miot-spec-v2:device:light:0000A001:yeelink-lamp4:1",
      "instance": {
        "type": "urn:miot-spec-v2:device:light:0000A001:yeelink-lamp4:1",
        "services": [
          {
            "iid": 1,
            "type": "urn:miot-spec-v2:service:device-information:00007801:yeelink-lamp4:1",
            "properties": [
              {
                "iid": 2,
                "type": "urn:miot-spec-v2:property:model:00000002:yeelink-lamp4:1",
                "format": "string",
                "access": [
                  "read"
                ]
              }
            ]
          },
          {
            "iid": 2,
            "type": "urn:miot-spec-v2:service:light:00007802:yeelink-lamp4:1",
            "properties": [
              {
                "iid": 2,
                "type": "urn:miot-spec-v2:property:brightness:0000000D:yeelink-lamp4:1",
                "format": "uint8",
                "access": [
                  "read",
                  "write",
                  "notify"
                ],
                "unit": "percentage",
                "value-range": [
                  1,
                  100,
                  1
                ]
              }
            ]
          }
        ]
      }
    },
    "dmaker.fan.p5": {
      "source": "https://miot-spec.org/miot-spec-v2/instance?type=urn:miot-spec-v2:device:fan:0000A005:dmaker-p5:1",
      "instance": {
        "type": "urn:miot-spec-v2:device:fan:0000A005:dmaker-p5:1",
        "services": [
          {
            "iid": 2,
            "type": "urn:miot-spec-v2:service:fan:00007808:dmaker-p5:1",
            "properties": [
              {
                "iid": 4,
