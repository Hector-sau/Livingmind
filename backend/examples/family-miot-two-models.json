                  {
                    "value": 2,
                    "description": "Level2"
                  },
                  {
                    "value": 3,
                    "description": "Level3"
                  },
                  {
                    "value": 4,
                    "description": "Level4"
                  }
                ]
              },
              {
                "iid": 5,
                "type": "urn:miot-spec-v2:property:horizontal-swing-included-angle:0000011B:dmaker-p5:1",
                "format": "uint16",
                "access": [
                  "read",
                  "write",
                  "notify"
                ],
                "value-list": [
                  {
                    "value": 30,
                    "description": "30"
                  },
                  {
                    "value": 60,
                    "description": "60"
                  },
                  {
                    "value": 90,
                    "description": "90"
                  },
                  {
                    "value": 120,
                    "description": "120"
                  },
                  {
                    "value": 140,
                    "description": "140"
                  }
                ]
              },
              {
                "iid": 6,
                "type": "urn:miot-spec-v2:property:fan-level:00000016:dmaker-p5:1",
                "format": "uint8",
                "access": [
                  "read",
                  "write",
                  "notify"
                ],
                "value-range": [
                  1,
                  100,
                  1
                ]
              },
              {
                "iid": 7,
                "type": "urn:miot-spec-v2:property:horizontal-angle:00000019:dmaker-p5:1",
