# Copy to .env and start the backend with:  uvicorn app.main:app --env-file .env ...
# Secrets live ONLY here (backend). Never put keys in the app or in EXPO_PUBLIC_* variables.
# Format: KEY=value  — no spaces around "=", no quotes needed. (A space after "=" makes
# `source .env` try to run the value as a command.)
# Keep LIVINGMIND_MODEL_TIMEOUT_S modest (<= 10); the app waits planner timeout + 3 s for a plan.

LIVINGMIND_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Planner: rule | model  (model = Experience Agent calls the provider, falls back to rules on failure)
LIVINGMIND_PLANNER_MODE=rule
LIVINGMIND_MODEL_PROVIDER=deepseek
LIVINGMIND_MODEL_TIMEOUT_S=6
# Sized for a reasoning model: deepseek-flash wrote 1280-1387 characters of reasoning before its
# answer, charged against this same budget, which a 400-token cap could not hold. The default model
# does not reason at length, so this cap is slack for it -- keep the headroom if you switch models.
LIVINGMIND_MODEL_MAX_TOKENS=2000
# Optional connection-pool experiment. The 40-call comparison did not improve P95,
# so the established per-call transport remains the default.
LIVINGMIND_MODEL_REUSE_CONNECTIONS=0

# Optional durable virtual gateway. Requires PostgreSQL; no public device endpoint.
LIVINGMIND_GATEWAY_URL=
LIVINGMIND_GATEWAY_TOKEN=
LIVINGMIND_GATEWAY_TIMEOUT_S=3

# DeepSeek (https://api-docs.deepseek.com). Leave the key empty to disable model calls.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Energy (step 8). Fix the local hour for the time-of-use tariff so demos are repeatable
# (e.g. 20 = peak). Leave empty to use the real clock (UTC offset below).
LIVINGMIND_DEMO_LOCAL_HOUR=
LIVINGMIND_LOCAL_UTC_OFFSET=8
