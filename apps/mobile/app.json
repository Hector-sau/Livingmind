{
  "expo": {
    "name": "LivingMind",
    "slug": "livingmind",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.livingmind.demo",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "连接同一局域网里的 LivingMind 演示后端"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0F9FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.livingmind.demo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F9FF"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "LivingMind 需要麦克风才能听你说话。",
          "speechRecognitionPermission": "LivingMind 用设备自带的识别把你说的话变成指令；开启端侧识别时音频不会离开这台设备。",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ]
  }
}
