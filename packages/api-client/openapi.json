{
  "components": {
    "schemas": {
      "ActionResult": {
        "properties": {
          "actionId": {
            "title": "Actionid",
            "type": "string"
          },
          "command": {
            "enum": [
              "set_brightness",
              "set_target_temperature",
              "set_open_percent"
            ],
            "title": "Command",
            "type": "string"
          },
          "device": {
            "enum": [
              "light",
              "ac",
              "curtain"
            ],
            "title": "Device",
            "type": "string"
          },
          "observedValue": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Value read back from the device after the write",
            "title": "Observedvalue"
          },
          "outcome": {
            "enum": [
              "succeeded",
              "rejected",
              "failed",
              "skipped"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "actionId",
          "device",
          "command",
          "value",
          "outcome",
          "reason",
          "observedValue"
        ],
        "title": "ActionResult",
        "type": "object"
      },
      "ActivityRecord": {
        "properties": {
          "action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActionResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "activityId": {
            "title": "Activityid",
            "type": "string"
          },
          "kind": {
            "enum": [
              "plan_created",
              "plan_fallback",
              "plan_confirmed",
              "plan_confirm_repeated",
              "plan_rejected",
              "action_executed",
              "action_rejected",
              "service_stopped",
              "demo_reset"
            ],
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "personId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Personid"
          },
          "planId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planid"
          },
          "serviceId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serviceid"
          },
          "source": {
            "enum": [
              "user",
              "rule_engine",
              "experience_agent",
              "executor",
              "virtual_device",
              "system",
              "frontend_mock"
            ],
            "title": "Source",
            "type": "string"
          },
          "spaceId": {
            "title": "Spaceid",
            "type": "string"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "activityId",
          "timestamp",
          "spaceId",
          "kind",
          "source",
          "message",
          "serviceId",
          "planId",
          "personId",
          "action"
        ],
        "title": "ActivityRecord",
        "type": "object"
      },
      "ActivityResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ActivityRecord"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ActivityResponse",
        "type": "object"
      },
      "BootstrapResponse": {
        "properties": {
          "account": {
            "$ref": "#/components/schemas/DemoAccount"
          },
          "activeService": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Service"
              },
              {
                "type": "null"
              }
            ]
          },
          "defaultSpaceId": {
            "title": "Defaultspaceid",
            "type": "string"
          },
          "deviceState": {
            "$ref": "#/components/schemas/DeviceState"
          },
          "mode": {
            "const": "demo",
            "title": "Mode",
            "type": "string"
          },
          "persons": {
            "items": {
              "$ref": "#/components/schemas/Person"
            },
            "title": "Persons",
            "type": "array"
          },
          "planner": {
            "$ref": "#/components/schemas/PlannerInfo"
          },
          "spaces": {
            "items": {
              "$ref": "#/components/schemas/Space"
            },
            "title": "Spaces",
            "type": "array"
          }
        },
        "required": [
          "mode",
          "planner",
          "account",
          "persons",
          "spaces",
          "defaultSpaceId",
          "deviceState",
          "activeService"
        ],
        "title": "BootstrapResponse",
        "type": "object"
      },
      "ConfirmPlanRequest": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/RequestContext"
          },
          "planVersion": {
            "title": "Planversion",
            "type": "integer"
          }
        },
        "required": [
          "context",
          "planVersion"
        ],
        "title": "ConfirmPlanRequest",
        "type": "object"
      },
      "ConfirmPlanResponse": {
        "properties": {
          "deviceState": {
            "$ref": "#/components/schemas/DeviceState"
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "repeated": {
            "description": "True when the plan was already executed; nothing was re-run",
            "title": "Repeated",
            "type": "boolean"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ActionResult"
            },
            "title": "Results",
            "type": "array"
          },
          "service": {
            "$ref": "#/components/schemas/Service"
          }
        },
        "required": [
          "plan",
          "service",
          "results",
          "deviceState",
          "repeated"
        ],
        "title": "ConfirmPlanResponse",
        "type": "object"
      },
      "CreateRestPlanRequest": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/RequestContext"
          },
          "mode": {
            "anyOf": [
              {
                "enum": [
                  "rule",
                  "model"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "null = server default",
            "title": "Mode"
          },
          "utterance": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Utterance",
            "type": "string"
          }
        },
        "required": [
          "context",
          "utterance"
        ],
        "title": "CreateRestPlanRequest",
        "type": "object"
      },
      "DemoAccount": {
        "description": "Demo identity only. This is NOT authentication.",
        "properties": {
          "accountId": {
            "title": "Accountid",
            "type": "string"
          },
          "displayName": {
            "title": "Displayname",
            "type": "string"
          },
          "isDemo": {
            "title": "Isdemo",
            "type": "boolean"
          }
        },
        "required": [
          "accountId",
          "displayName",
          "isDemo"
        ],
        "title": "DemoAccount",
        "type": "object"
      },
      "DeviceAction": {
        "properties": {
          "actionId": {
            "title": "Actionid",
            "type": "string"
          },
          "command": {
            "enum": [
              "set_brightness",
              "set_target_temperature",
              "set_open_percent"
            ],
            "title": "Command",
            "type": "string"
          },
          "device": {
            "enum": [
              "light",
              "ac",
              "curtain"
            ],
            "title": "Device",
            "type": "string"
          },
          "label": {
            "description": "Human readable description shown in the app",
            "title": "Label",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "actionId",
          "device",
          "command",
          "value",
          "label"
        ],
        "title": "DeviceAction",
        "type": "object"
      },
      "DeviceState": {
        "properties": {
          "acTargetTempC": {
            "title": "Actargettempc",
            "type": "number"
          },
          "curtainOpenPercent": {
            "title": "Curtainopenpercent",
            "type": "integer"
          },
          "lightBrightness": {
            "title": "Lightbrightness",
            "type": "integer"
          },
          "source": {
            "enum": [
              "virtual_device",
              "frontend_mock"
            ],
            "title": "Source",
            "type": "string"
          },
          "spaceId": {
            "title": "Spaceid",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          },
          "version": {
            "description": "Increments on every successful device write",
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "spaceId",
          "lightBrightness",
          "acTargetTempC",
          "curtainOpenPercent",
          "source",
          "version",
          "updatedAt"
        ],
        "title": "DeviceState",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "enum": [
              "VALIDATION_ERROR",
              "NOT_FOUND",
              "FORBIDDEN_CONTEXT",
              "PLAN_EXPIRED",
              "PLAN_INVALIDATED",
              "PLAN_VERSION_MISMATCH",
              "SERVICE_ALREADY_ACTIVE",
              "SERVICE_NOT_ACTIVE",
              "INTERNAL_ERROR"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Person": {
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "personId": {
            "title": "Personid",
            "type": "string"
          },
          "restPreference": {
            "$ref": "#/components/schemas/RestPreference"
          }
        },
        "required": [
          "personId",
          "name",
          "description",
          "restPreference"
        ],
        "title": "Person",
        "type": "object"
      },
      "Plan": {
        "properties": {
          "actions": {
            "items": {
              "$ref": "#/components/schemas/DeviceAction"
            },
            "title": "Actions",
            "type": "array"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "generation": {
            "$ref": "#/components/schemas/PlanGeneration"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "title": "Notes",
            "type": "array"
          },
          "personId": {
            "title": "Personid",
            "type": "string"
          },
          "planId": {
            "title": "Planid",
            "type": "string"
          },
          "scenario": {
            "const": "rest",
            "title": "Scenario",
            "type": "string"
          },
          "source": {
            "enum": [
              "rule",
              "model",
              "rule_fallback",
              "frontend_mock"
            ],
            "title": "Source",
            "type": "string"
          },
          "spaceId": {
            "title": "Spaceid",
            "type": "string"
          },
          "status": {
            "enum": [
              "proposed",
              "executed",
              "expired",
              "invalidated"
            ],
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "utterance": {
            "title": "Utterance",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "planId",
          "version",
          "personId",
          "spaceId",
          "scenario",
          "source",
          "summary",
          "notes",
          "utterance",
          "actions",
          "status",
          "createdAt",
          "expiresAt",
          "generation"
        ],
        "title": "Plan",
        "type": "object"
      },
      "PlanGeneration": {
        "description": "How the plan was produced. Shown in the app so sources are never confused.",
        "properties": {
          "fallbackReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why the rule engine was used instead of the model",
            "title": "Fallbackreason"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Experience goal stated by the model",
            "title": "Goal"
          },
          "latencyMs": {
            "description": "Time from request to plan (server side)",
            "title": "Latencyms",
            "type": "integer"
          },
          "modeRequested": {
            "enum": [
              "rule",
              "model"
            ],
            "title": "Moderequested",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Model name actually called; null for rule plans",
            "title": "Model"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "e.g. deepseek; null for rule plans",
            "title": "Provider"
          }
        },
        "required": [
          "modeRequested",
          "provider",
          "model",
          "latencyMs",
          "fallbackReason",
          "goal"
        ],
        "title": "PlanGeneration",
        "type": "object"
      },
      "PlannerInfo": {
        "properties": {
          "defaultMode": {
            "enum": [
              "rule",
              "model"
            ],
            "title": "Defaultmode",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "modelConfigured": {
            "description": "A provider and key are configured server-side (not proof it works)",
            "title": "Modelconfigured",
            "type": "boolean"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "timeoutMs": {
            "title": "Timeoutms",
            "type": "integer"
          }
        },
        "required": [
          "defaultMode",
          "modelConfigured",
          "provider",
          "model",
          "timeoutMs"
        ],
        "title": "PlannerInfo",
        "type": "object"
      },
      "RequestContext": {
        "description": "Who is acting, for whom, and where. Checked server-side against demo memberships.",
        "properties": {
          "accountId": {
            "title": "Accountid",
            "type": "string"
          },
          "personId": {
            "title": "Personid",
            "type": "string"
          },
          "spaceId": {
            "title": "Spaceid",
            "type": "string"
          }
        },
        "required": [
          "accountId",
          "personId",
          "spaceId"
        ],
        "title": "RequestContext",
        "type": "object"
      },
      "RestPreference": {
        "properties": {
          "acTargetTempC": {
            "description": "Preferred AC set point, Celsius",
            "maximum": 30.0,
            "minimum": 16.0,
            "title": "Actargettempc",
            "type": "number"
          },
          "curtainOpenPercent": {
            "description": "Preferred curtain opening, percent",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Curtainopenpercent",
            "type": "integer"
          },
          "lightBrightness": {
            "description": "Preferred light brightness, percent",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Lightbrightness",
            "type": "integer"
          }
        },
        "required": [
          "lightBrightness",
          "acTargetTempC",
          "curtainOpenPercent"
        ],
        "title": "RestPreference",
        "type": "object"
      },
      "Service": {
        "properties": {
          "personId": {
            "title": "Personid",
            "type": "string"
          },
          "planId": {
            "title": "Planid",
            "type": "string"
          },
          "planVersion": {
            "title": "Planversion",
            "type": "integer"
          },
          "serviceId": {
            "title": "Serviceid",
            "type": "string"
          },
          "spaceId": {
            "title": "Spaceid",
            "type": "string"
          },
          "startedAt": {
            "format": "date-time",
            "title": "Startedat",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "stopped"
            ],
            "title": "Status",
            "type": "string"
          },
          "stoppedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stoppedat"
          }
        },
        "required": [
          "serviceId",
          "spaceId",
          "personId",
          "planId",
          "planVersion",
          "status",
          "startedAt",
          "stoppedAt"
        ],
        "title": "Service",
        "type": "object"
      },
      "Space": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "spaceId": {
            "title": "Spaceid",
            "type": "string"
          }
        },
        "required": [
          "spaceId",
          "name"
        ],
        "title": "Space",
        "type": "object"
      },
      "StopServiceRequest": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/RequestContext"
          }
        },
        "required": [
          "context"
        ],
        "title": "StopServiceRequest",
        "type": "object"
      },
      "StopServiceResponse": {
        "properties": {
          "deviceState": {
            "$ref": "#/components/schemas/DeviceState"
          },
          "service": {
            "$ref": "#/components/schemas/Service"
          }
        },
        "required": [
          "service",
          "deviceState"
        ],
        "title": "StopServiceResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "LivingMind API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bootstrap": {
      "get": {
        "operationId": "getBootstrap",
        "parameters": [
          {
            "in": "query",
            "name": "accountId",
            "required": true,
            "schema": {
              "title": "Accountid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Get Bootstrap",
        "tags": [
          "demo"
        ]
      }
    },
    "/api/demo/reset": {
      "post": {
        "operationId": "resetDemo",
        "parameters": [
          {
            "in": "query",
            "name": "accountId",
            "required": true,
            "schema": {
              "title": "Accountid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Reset Demo",
        "tags": [
          "demo"
        ]
      }
    },
    "/api/plans/rest": {
      "post": {
        "operationId": "createRestPlan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRestPlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
